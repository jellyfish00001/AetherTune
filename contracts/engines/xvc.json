{
  "family": "streaming-vc",
  "capabilities": [
    "realtime_vc"
  ],
  "referenceVoice": true,
  "classification": "WAITING",
  "implementation": "implemented",
  "requiredPaths": [
    "tools/venvs/xvc/Scripts/python.exe",
    "tools/xvc-run.py",
    "services/engines/stream_runtime.py",
    "services/engines/streaming_adapters.py",
    "services/engines/postfx.py",
    "tools/external/X-VC/configs/xvc.yaml",
    "models/xvc/xvc.pt",
    "models/xvc/glm-tokenizer/model.safetensors",
    "models/xvc/eres2net/pretrained_eres2net.ckpt"
  ],
  "id": "xvc",
  "name": "X-VC",
  "adapter": "stream_runner",
  "limitations": [
    "START 直接開啟麥克風與輸出，使用常駐模型與 rolling codec window。",
    "即時模式 current 必須大於 0；處理速度、物理聽評與 LIVE_GATE 需獨立驗證。"
  ],
  "parameters": [
    {
      "name": "current",
      "label": "Current (ms)",
      "type": "number",
      "level": "advanced",
      "default": 160,
      "min": 0,
      "max": 5000,
      "step": 1,
      "runtime": false
    },
    {
      "name": "chunk",
      "label": "Chunk (ms)",
      "type": "number",
      "level": "advanced",
      "default": 2400,
      "min": 1,
      "max": 60000,
      "step": 1,
      "runtime": false
    },
    {
      "name": "future",
      "label": "Future (ms)",
      "type": "number",
      "level": "advanced",
      "default": 80,
      "min": 0,
      "max": 5000,
      "step": 1,
      "runtime": false
    },
    {
      "name": "smooth",
      "label": "Smooth (ms)",
      "type": "number",
      "level": "advanced",
      "default": 20,
      "min": 0,
      "max": 5000,
      "step": 1,
      "runtime": false
    }
  ]
}
