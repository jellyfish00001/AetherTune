{
  "family": "streaming-vc",
  "capabilities": [
    "realtime_vc"
  ],
  "referenceVoice": true,
  "classification": "WAITING",
  "implementation": "skeleton",
  "requiredPaths": [
    "tools/venvs/xvc/Scripts/python.exe",
    "tools/xvc-run.py",
    "tools/external/X-VC/configs/xvc.yaml",
    "models/xvc/xvc.pt",
    "models/xvc/glm-tokenizer/model.safetensors",
    "models/xvc/eres2net/pretrained_eres2net.ckpt"
  ],
  "id": "xvc",
  "name": "X-VC",
  "adapter": "file_runner",
  "limitations": [
    "第一輪僅 WAV streaming runner；current=0 為 offline。即時 capture/output 尚未整合。"
  ],
  "parameters": [
    {
      "name": "current",
      "label": "Current (ms)",
      "type": "number",
      "level": "advanced",
      "default": 160,
      "min": 0,
      "max": 5000,
      "step": 1,
      "runtime": false
    },
    {
      "name": "chunk",
      "label": "Chunk (ms)",
      "type": "number",
      "level": "advanced",
      "default": 2400,
      "min": 1,
      "max": 60000,
      "step": 1,
      "runtime": false
    },
    {
      "name": "future",
      "label": "Future (ms)",
      "type": "number",
      "level": "advanced",
      "default": 80,
      "min": 0,
      "max": 5000,
      "step": 1,
      "runtime": false
    },
    {
      "name": "smooth",
      "label": "Smooth (ms)",
      "type": "number",
      "level": "advanced",
      "default": 20,
      "min": 0,
      "max": 5000,
      "step": 1,
      "runtime": false
    }
  ]
}
