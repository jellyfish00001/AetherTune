{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TranscriptEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "session_id",
    "source_id",
    "source_type",
    "speaker_id",
    "device_id",
    "started_at",
    "ended_at",
    "language",
    "text",
    "confidence",
    "provider",
    "transcript_provider"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "enum": [
        "self",
        "remote",
        "manual"
      ]
    },
    "speaker_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "device_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "type": "string"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "provider": {
      "type": "string"
    },
    "transcript_provider": {
      "enum": [
        "parallel_stt",
        "backend_stt",
        "manual_text",
        "system"
      ]
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "enum": [
        "manual",
        "stt",
        "system"
      ]
    },
    "speech_status": {
      "enum": [
        "completed"
      ]
    },
    "engine_id": {
      "type": "string"
    },
    "voice_profile_id": {
      "type": "string"
    },
    "metrics": {
      "type": "object"
    }
  }
}
