{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethertune.local/schema/audio-rack/evidence-v1",
  "title": "AetherTune Audio Rack Evidence v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "pair_group_id",
    "backend_id",
    "route_profile",
    "rack_mode",
    "capture",
    "timing_ms",
    "continuity",
    "output_validation",
    "artifacts",
    "delta_latency_ms"
  ],
  "properties": {
    "schema_version": {"const": "aethertune-audio-rack/evidence-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "pair_group_id": {"type": "string", "minLength": 1},
    "backend_id": {"type": "string", "minLength": 1},
    "route_profile": {"type": "string", "minLength": 1},
    "rack_mode": {"enum": ["bypass", "full-chain"]},
    "capture": {
      "type": "object",
      "required": ["input_wav", "input_sha256", "reference_wav", "reference_sha256"],
      "properties": {
        "input_wav": {"type": "string", "minLength": 1},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "reference_wav": {"type": "string", "minLength": 1},
        "reference_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "timing_ms": {
      "type": "object",
      "required": ["backend_first_packet_ms", "postfx_first_packet_ms", "routing_first_packet_ms", "e2e_first_packet_ms", "e2e_p50_ms", "e2e_p95_ms"],
      "properties": {
        "backend_first_packet_ms": {"type": "number", "minimum": 0},
        "postfx_first_packet_ms": {"type": "number", "minimum": 0},
        "routing_first_packet_ms": {"type": "number", "minimum": 0},
        "e2e_first_packet_ms": {"type": "number", "minimum": 0},
        "e2e_p50_ms": {"type": "number", "minimum": 0},
        "e2e_p95_ms": {"type": "number", "minimum": 0}
      }
    },
    "continuity": {
      "type": "object",
      "required": ["continuous_seconds", "dropouts", "underruns"],
      "properties": {
        "continuous_seconds": {"type": "number", "minimum": 0},
        "dropouts": {"type": "integer", "minimum": 0},
        "underruns": {"type": "integer", "minimum": 0}
      }
    },
    "output_validation": {
      "type": "object",
      "required": ["status", "finite", "non_zero"],
      "properties": {
        "status": {"enum": ["PASS", "WAITING", "FAIL"]},
        "finite": {"type": "boolean"},
        "non_zero": {"type": "boolean"}
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["output_wav", "metrics_json", "wav_sha256", "paired_evidence_path"],
      "properties": {
        "output_wav": {"type": "string", "minLength": 1},
        "metrics_json": {"type": "string", "minLength": 1},
        "wav_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "paired_evidence_path": {"type": "string", "minLength": 1}
      }
    },
    "delta_latency_ms": {"type": ["number", "null"]}
  }
}
